{
  "name": "gps-video-player",
  "private": false,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && vite --config demo/vite.config.js --host 0.0.0.0 --port 5173",
    "build": "vite build && node scripts/validate-build.mjs",
    "demo": "node demo/server.mjs",
    "test": "node --test src/*.test.js scripts/*.test.mjs && npm run test:types",
    "test:types": "node scripts/test-types.mjs",
    "verify": "node tests/verify.mjs",
    "test:browser": "node tests/verify.mjs && node scripts/verify-camera.mjs",
    "test:camera": "node scripts/verify-camera.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "es-module-lexer": "^3.0.4",
    "esbuild": "^0.28.2",
    "vite": "^7.0.0",
    "@deck.gl/core": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/mapbox": "9.4.0",
    "maplibre-gl": "6.14.0",
    "typescript": "^5.9.3"
  },
  "description": "Embeddable synchronized IGC and video player",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manuelseeger/gps-video-player.git"
  },
  "homepage": "https://github.com/manuelseeger/gps-video-player#readme",
  "bugs": {
    "url": "https://github.com/manuelseeger/gps-video-player/issues"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/player.js"
    }
  },
  "types": "./index.d.ts",
  "module": "./dist/player.js",
  "files": [
    "index.d.ts",
    "dist/player.js",
    "README.md",
    "dist/THIRD_PARTY_NOTICES.txt"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  }
}
